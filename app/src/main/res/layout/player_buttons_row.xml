<?xml version="1.0" encoding="utf-8"?>
<!-- 播放控制按钮行：模式 / 上一曲 / 播放暂停 / 下一曲，四按钮等宽。
     图标内边距由 PlayerActivity 按按钮实际尺寸在运行时计算（见 applyAdaptiveControlSizes），
     这样窄屏（手机横屏）上图标不会被 padding 挤得很小，宽屏（4:3 车机）上也不会过大。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_media_controller_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="4dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- 合并循环/随机：单个播放模式按钮（顺序→单曲循环→随机循环） -->
    <ImageButton
        android:id="@+id/player_mode_button"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_weight="1"
        android:background="@drawable/round_selector"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_repeat_white_24dp" />

    <ImageButton
        android:id="@+id/player_prev_button"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_weight="1"
        android:background="@drawable/round_selector"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_previous_white_24dp" />

    <!-- 播放/暂停：无白色底、稍小，透明背景 -->
    <ImageButton
        android:id="@+id/player_play_pause_button"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_weight="1"
        android:background="@drawable/round_selector"
        android:padding="23dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play_arrow_white_24dp" />

    <ImageButton
        android:id="@+id/player_next_button"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:layout_weight="1"
        android:background="@drawable/round_selector"
        android:padding="20dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_skip_next_white_24dp" />
</LinearLayout>
