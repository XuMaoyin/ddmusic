<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="top.juluo.ddmusic">

    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".activity.MainActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 播放页：跟随横竖屏切换布局（横屏=左右分布、竖屏=上下分布），因此不处理 orientation/screenSize，由系统重建加载对应 layout-land 布局 -->
        <activity
            android:name=".activity.PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/PlayerTheme" />

        <!-- 设置页：曲库扫描目录排除等 -->
        <activity
            android:name=".activity.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- 设置二级页：曲库扫描目录 / 关于 -->
        <activity
            android:name=".activity.ScanDirsActivity"
            android:exported="false"
            android:label="@string/settings_scan_dirs" />

        <activity
            android:name=".activity.AboutActivity"
            android:exported="false"
            android:label="@string/settings_about" />

        <!-- 播放服务：前台 + 系统媒体会话（通知栏/方向盘媒体键） -->
        <service
            android:name=".service.MusicService"
            android:exported="true"
            android:stopWithTask="false" />

        <!-- 车机小迪语音（BYD AUTOVOICE 定向广播 + 系统媒体按键兜底） -->
        <receiver
            android:name=".receiver.VoiceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.byd.action.AUTOVOICE_PLAY_RANDOM" />
                <action android:name="com.byd.action.AUTOVOICE_SEARCH" />
                <action android:name="com.byd.action.AUTOVOICE_SEARCH_PLUS" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_FAVORITE" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_LATELY" />
                <action android:name="com.byd.action.AUTOVOICE_PLAY_DOWNLOAD" />
                <action android:name="com.byd.action.AUTOVOICE_RECOMMEND" />
                <action android:name="com.byd.action.AUTOVOICE_JUMP_TO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
